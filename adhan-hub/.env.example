# ─────────────────────────────────────────────
# KHUSHU — Environment Variables
# Copy to .env (local) or set in your host's variable settings (Railway).
# Never commit real values.
# ─────────────────────────────────────────────

PORT=3000

# Timezone used by the Pi adhan player scheduler (IANA name)
TZ=America/Chicago

# ── Security ─────────────────────────────────
# Required to use the admin screen / change the admin profile (which also drives the Pi player).
# At least 16 characters. Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If unset, admin features are disabled.
ADMIN_TOKEN=

# Profile id that the Pi adhan player reads its settings from (default: admin)
ADMIN_PROFILE_ID=admin

# Only needed if you serve the UI from a different origin than the API (default: same-origin only)
# CORS_ORIGIN=https://your-ui.example.com

# ── Duas (Ummah API) ─────────────────────────
# Get a key at https://ummahapi.com. Without it, the Duas tab shows an error.
UMMAH_API_KEY=

# ── Prayer times ─────────────────────────────
# Your coordinates and timezone (https://www.latlong.net). Aladhan calculates times from these.
LATITUDE=
LONGITUDE=
# Aladhan method: 2 = ISNA (North America). See https://aladhan.com/calculation-methods
ALADHAN_METHOD=2
# Asr school: 0 = Shafi/standard, 1 = Hanafi
ALADHAN_SCHOOL=1
