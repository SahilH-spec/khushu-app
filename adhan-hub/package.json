{
  "name": "khushu",
  "version": "1.0.0",
  "description": "Khushu — Islamic family app: prayer times, Quran, Dhikr, and Raspberry Pi adhan player",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
